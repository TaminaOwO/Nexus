# Fugle API Configuration
FUGLE_API_KEY=your_fugle_api_key_here

# Discord Webhook Configuration
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here
DISCORD_NOTIFICATION_ENABLED=true

# Database Configuration (Optional, defaults to nexus.db)
# DATABASE_PATH=nexus.db

# Auth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
OWNER_EMAIL=your_email@gmail.com
NEXUS_API_KEY=your_random_api_key_for_ios_shortcuts
JWT_SECRET=your_random_jwt_secret
