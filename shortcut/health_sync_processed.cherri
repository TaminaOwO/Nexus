/*
Basic Actions and Global Types
*/




























// [Doc]: Stop Shortcut: Stops the shortcut.


// [Doc]: Nothing: Clear the current output.


// [Doc]: Comment: Add an explicit comment.


// [Doc]: Get Type: Get the type of input.


// [Doc]: Get Object of Class: Get the object of `class` from a variable.


// [Doc]: [Output] Show Result: Show `input`.


// [Doc]: [Output] Quick Look: Preview `input` in Quick Look.


// [Doc]: [Output] Stop and Output: Stop and output `output`. Do nothing if there is nowhere to output.


// [Doc]: [Output] Output or Copy to Clipboard: Stop and output `output`. Copy to the clipboard if there is nowhere to output.




// [Doc]: [Output] Must Output: Stop and output `output`. Respond with response if there is nowhere to output.




// [Doc]: [Output] Content Graph: Display input as a content graph.










// [Doc]: Count: Returns a count of `type` of items in `input`.


// [Doc]: [Notifications] Alert: Shows an alert with text and optional title and an OK button to proceed.




// [Doc]: [Notifications] Confirm: Shows an alert with text and optional title. It displays an OK button to proceed, and a cancel button that stops the Shortcut.




// [Doc]: [Notifications] Show Notification: Shows a custom notification message.







// [Doc]: Number: Create a number value.




// [Doc]: [Control Flow] Wait: Wait a specified number of seconds.


// [Doc]: [Control Flow] Wait to Return: Wait for the user to return to Shortcuts.


// [Doc]: [Search] Search/Spotlight: Get results from search on iOS or iPadOS, and Spotlight on macOS.



/*
Web Actions
*/

// [Doc]: [URLs] Open URL: Open URL in default browser.




// [Doc]: [URLs] Expand URL: Get the expanded version of a URL. For instance, returns the full URL for a short URL, or the URL which a URL immediately redirects to, etc.


// [Doc]: [URLs] Get URLs: Get URLs from `input`.













// [Doc]: [URLs] Get URL Detail: Get a detail about a URL.


// [Doc]: [URLs] Get URL Headers: Get the headers from a URL.


// [Doc]: [URLs] URL Encode: Encode text for a URL.




// [Doc]: [URLs] URL Decode: Decode text from URL encoding.




// [Doc]: [URLs] Open X-Callback URL


// [Doc]: [Safari] Get Current URL: Get current URL in Safari.


// [Doc]: [Safari] Show Webpage: Show webpage using Safari.


// [Doc]: [Safari] Run JavaScript on Webpage: Run some custom JavaScript on the current webpage in Safari.









// [Doc]: [Safari] Get Webpage Detail: Get a detail about a provided webpage.














// [Doc]: [Safari] Search Web: Search the web using a provided search engine and query.


// [Doc]: [Safari] Get Webpage Contents: Get contents of Webpage from Safari.


// [Doc]: [Giphy] Get GIFs from Giphy: Gets a number of GIFs from Giphy for a search query.




// [Doc]: [Giphy] Search Giphy: Gets GIFs from Giphy for a search query.


// [Doc]: [Articles] Get Article: Get article from webpage.


// [Doc]: [Articles] Get Article Detail: Get a detail about an article.


// [Doc]: [RSS] Get RSS: Get RSS feed contents at URL. Limited by number of items.


// [Doc]: [RSS] Get RSS Feeds: Get feeds from multiple URLs.









// [Doc]: [HTTP] Download URL: Download the contents of a URL.




// [Doc]: [HTTP] Form Request: Send a `method` request to `url` with `body` and optional `headers.









// [Doc]: [HTTP] JSON Request: Send a `method` JSON request to `url` with `body` and optional `headers.









// [Doc]: [HTTP] File Request: Send a `method` file request to `url` with `body` and optional `headers.









/*
Calendar Actions
*/









































// [Doc]: [Calendars] Add Calendar: Create a calendar with `name`.


// [Doc]: [Calendars] Open Event in Calendar: Show `event` in the calendar app.


// [Doc]: [Calendars] Edit Event: Edit a detail of an event. Provide an event, a detail to modify, and a new value for that detail.


// [Doc]: [Calendars] Get Event Detail: Get a detail of an event.


// [Doc]: [Calendars] Remove Events: Remove an event.


// [Doc]: [Reminders] Open Reminders List


// [Doc]: [Reminders] Add Quick Reminder


// [Doc]: [Reminders] Remove Reminders


// [Doc]: [Alarms] Get Alarms: Returns all of the alarms on the device.


// [Doc]: [Dates] Get Dates: Get dates from input.


// [Doc]: [Dates] Date: Create a date value from `date`. Example: October 5, 2022.



























































// [Doc]: [Dates] Get Holiday Date: Get the date of a holiday, optionally specifically for a few past or future years.


// [Doc]: [Dates] Current Date: Get the current date.























// [Doc]: [Formatting] Format Date: Format a date using a standard or custom format.




// [Doc]: [Formatting] Format Time: Format a time using a standard or custom format.




// [Doc]: [Formatting] Format Timestamp: Format a timestamp using standard formats and/or a custom date format.








// 1. 取得並格式化今日日期
@today = formatDate(CurrentDate, "Custom", "yyyy-MM-dd")

// 2. 取得健康數據

// 睡眠: 在床上總時數（Sleep Analysis, 昨天, 總和）
@sleep_samples = rawAction("is.workflow.actions.health.quantity.get", {
    "WFSampleType": "HKCategoryTypeIdentifierSleepAnalysis",
    "WFStartDate": "Yesterday"
})
@sleep_hours = rawAction("is.workflow.actions.math.statistics", {
    "WFStatisticsOperation": "Sum",
    "WFInput": "${sleep_samples}"
})

// HRV: 心率變異性（昨天, 平均值）
@hrv_samples = rawAction("is.workflow.actions.health.quantity.get", {
    "WFSampleType": "HKQuantityTypeIdentifierHeartRateVariabilitySDNN",
    "WFStartDate": "Yesterday"
})
@hrv = rawAction("is.workflow.actions.math.statistics", {
    "WFStatisticsOperation": "Average",
    "WFInput": "${hrv_samples}"
})

// 靜止心率（昨天, 平均值）
@resting_samples = rawAction("is.workflow.actions.health.quantity.get", {
    "WFSampleType": "HKQuantityTypeIdentifierRestingHeartRate",
    "WFStartDate": "Yesterday"
})
@resting_hr = rawAction("is.workflow.actions.math.statistics", {
    "WFStatisticsOperation": "Average",
    "WFInput": "${resting_samples}"
})

// 活動卡路里: 活動能量（昨天, 總和）
@calorie_samples = rawAction("is.workflow.actions.health.quantity.get", {
    "WFSampleType": "HKQuantityTypeIdentifierActiveEnergyBurned",
    "WFStartDate": "Yesterday"
})
@active_calories = rawAction("is.workflow.actions.math.statistics", {
    "WFStatisticsOperation": "Sum",
    "WFInput": "${calorie_samples}"
})

// 體重: 最新一筆
@weight_samples = rawAction("is.workflow.actions.health.quantity.get", {
    "WFSampleType": "HKQuantityTypeIdentifierBodyMass",
    "WFNumberOfSamples": 1
})
@weight = rawAction("is.workflow.actions.properties.health.quantity", {
    "WFContentItemPropertyName": "Value",
    "WFInput": "${weight_samples}"
})

// 心情狀態: 昨天最新一筆
@mood_samples = rawAction("is.workflow.actions.health.quantity.get", {
    "WFSampleType": "HKCategoryTypeIdentifierStateOfMind",
    "WFStartDate": "Yesterday",
    "WFNumberOfSamples": 1
})
@mood_score = rawAction("is.workflow.actions.properties.health.quantity", {
    "WFContentItemPropertyName": "Value",
    "WFInput": "${mood_samples}"
})
@mood_label = rawAction("is.workflow.actions.properties.health.quantity", {
    "WFContentItemPropertyName": "Labels",
    "WFInput": "${mood_samples}"
})

// 3. 發送 POST 請求到 LifeOS API
@response = jsonRequest(
    "https://nexus-staging-1653.up.railway.app/api/lifeos/health/sync",
    "POST",
    {
        "date": "${today}",
        "sleep_hours": "${sleep_hours}",
        "hrv": "${hrv}",
        "resting_hr": "${resting_hr}",
        "active_calories": "${active_calories}",
        "weight": "${weight}",
        "mood_score": "${mood_score}",
        "mood_label": "${mood_label}"
    },
    {
        "X-API-Key": "7wd5l6rmAFPm5XO/mxYycPhAu3QD+HqeZ1CV3hSRVig=",
        "Content-Type": "application/json"
    }
)