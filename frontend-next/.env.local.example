# GitHub API (Headless CMS)
GITHUB_PAT=your_github_personal_access_token_here
GITHUB_OWNER=your_github_username
GITHUB_REPO=HQ

# Go API
NEXT_PUBLIC_GO_API_URL=http://localhost:8080

# Webhook revalidation
WEBHOOK_SECRET=your_32_char_random_secret_here

# Next Auth (if using Google OAuth)
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Nexus Backend API (Go backend on Railway)
NEXUS_BACKEND_URL=https://your-nexus-backend.up.railway.app
NEXUS_API_KEY=your_nexus_backend_api_key_here
